# Madamcutie Supabase PostgreSQL Connection Strings
# Replace [PROJECT-REF] and [YOUR-PASSWORD] with your actual Supabase credentials

# Transaction mode connection pooler (port 6543) - Used for Prisma Client queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session mode / direct connection (port 5432) - Used for Prisma migrations & db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional public Supabase client credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
